# Base de datos (Neon). DATABASE_URL = cadena "pooled"; DIRECT_URL = cadena directa (para migraciones).
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Google OAuth (Google Cloud Console › APIs y servicios › Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública de la app, sin barra final (ej.: https://metromail.vercel.app)
APP_URL=http://localhost:3000

# Secretos: genera cada uno con `openssl rand -base64 48`
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Organización
ALLOWED_DOMAINS=metrowan.cl          # dominios que pueden entrar, separados por comas
ADMIN_EMAILS=jose@metrowan.cl        # quienes son administradores desde el inicio

# Opcional: asistente IA
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Opcional: zona horaria del horario hábil (por defecto America/Santiago)
# APP_TIMEZONE=America/Santiago
